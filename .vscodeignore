# Development files
.vscode/**
.vscode-test/**
.claude/**
src/**
.gitignore
.gitattributes
tsconfig*.json
jest.config.js
webpack.config.js
.eslintrc.json

# Preview pages written by the visual-check harness. Gitignored, but vsce
# packages untracked files unless they are named here.
.preview/**

# Build files (keep only the bundled output)
out/src/**
out/**/*.d.ts
out/**/*.d.ts.map

# Dependencies (bundled by webpack)
# NOTE: this is why the codicon font is copied into media/ at build time rather
# than referenced from node_modules -- see webpack.config.js. media/** must stay
# packaged or the webview loads with no icons and no styles.
node_modules/**

# Development dependencies and tools
**/*.map
.nyc_output
coverage/**

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Yarn Integrity file
.yarn-integrity

# Package files
*.vsix

# Test files
test/**
**/*.test.ts
**/*.test.js

# Documentation source (keep README.md)
docs/**

# Temporary files
*.tmp
*.temp
.cache/**

# IDE files
*.swp
*.swo
*~

# Distribution folder if you have one
dist/**
