{
  "name": "jsonbro",
  "displayName": "JSONBro",
  "description": "A simple VS Code extension for working with JSON.",
  "version": "0.2.9",
  "license": "MIT",
  "publisher": "LucianDCrainic",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucianCrainic/JSONBro.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.81.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsonbro.formatJson",
        "title": "JSONBro: Format JSON"
      },
      {
        "command": "jsonbro.diffJson",
        "title": "JSONBro: Diff JSON"
      },
      {
        "command": "jsonbro.openFile",
        "title": "JSONBro: Open JSON File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jsonbro.openFromActivityBar",
        "title": "Open JSONBro",
        "icon": "$(json)"
      },
      {
        "command": "jsonbro.removeFormatHistory",
        "title": "Remove Entry",
        "icon": "$(trash)"
      },
      {
        "command": "jsonbro.removeDiffHistory",
        "title": "Remove Entry",
        "icon": "$(trash)"
      },
      {
        "command": "jsonbro.renameFormatHistory",
        "title": "Rename Entry",
        "icon": "$(edit)"
      },
      {
        "command": "jsonbro.renameDiffHistory",
        "title": "Rename Entry",
        "icon": "$(edit)"
      },
      {
        "command": "jsonbro.loadFormatHistory",
        "title": "JSONBro: Load Format History Entry"
      },
      {
        "command": "jsonbro.loadDiffHistory",
        "title": "JSONBro: Load Diff History Entry"
      },
      {
        "command": "jsonbro.clearHistory",
        "title": "Clear History",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jsonbro",
          "title": "JSONBro",
          "icon": "$(json)"
        }
      ]
    },
    "views": {
      "jsonbro": [
        {
          "id": "jsonbro.explorer",
          "name": "JSONBro",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jsonbro.openFromActivityBar",
          "when": "view == jsonbro.explorer",
          "group": "navigation"
        },
        {
          "command": "jsonbro.openFile",
          "when": "view == jsonbro.explorer",
          "group": "navigation@1"
        },
        {
          "command": "jsonbro.clearHistory",
          "when": "view == jsonbro.explorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jsonbro.renameFormatHistory",
          "when": "view == jsonbro.explorer && viewItem == formatHistoryEntry",
          "group": "inline@1"
        },
        {
          "command": "jsonbro.removeFormatHistory",
          "when": "view == jsonbro.explorer && viewItem == formatHistoryEntry",
          "group": "inline@2"
        },
        {
          "command": "jsonbro.renameDiffHistory",
          "when": "view == jsonbro.explorer && viewItem == diffHistoryEntry",
          "group": "inline@1"
        },
        {
          "command": "jsonbro.removeDiffHistory",
          "when": "view == jsonbro.explorer && viewItem == diffHistoryEntry",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "jsonbro.loadFormatHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.loadDiffHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.removeFormatHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.removeDiffHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.renameFormatHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.renameDiffHistory",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "JSONBro",
      "properties": {
        "jsonbro.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line numbers beside formatted JSON."
        },
        "jsonbro.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per level of indentation in formatted output."
        },
        "jsonbro.strictDiff": {
          "type": "boolean",
          "default": false,
          "description": "Start the diff view in strict mode, where keys present only on the right are ignored."
        },
        "jsonbro.defaultPaneRatio": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.2,
          "maximum": 0.8,
          "description": "Share of the width given to the input pane when the panel opens."
        },
        "jsonbro.autoFormatOnPaste": {
          "type": "boolean",
          "default": false,
          "description": "Format automatically when JSON is pasted into the input."
        },
        "jsonbro.search.defaultScope": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "keys",
            "values"
          ],
          "enumDescriptions": [
            "Search property names and values.",
            "Search property names only.",
            "Search values only."
          ],
          "description": "Which part of the document find starts by searching."
        },
        "jsonbro.maxInlineSize": {
          "type": "number",
          "default": 2097152,
          "description": "Characters of pasted input treated as editable. Larger documents are still formatted, but the panel stops trying to keep the input box responsive."
        },
        "jsonbro.diff.maxDocumentSize": {
          "type": "number",
          "default": 26214400,
          "description": "Largest document, in characters, that the diff view will compare. Comparing needs both sides in memory as values, so past this it reports the limit instead of attempting it."
        },
        "jsonbro.diff.arrayAlignBudget": {
          "type": "number",
          "default": 1000000,
          "description": "Ceiling on the array alignment pass, as old length times new length. Above it arrays are compared by position, which is faster but reports an insertion as a change to every later element."
        }
      }
    },
    "keybindings": [
      {
        "command": "jsonbro.formatJson",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      },
      {
        "command": "jsonbro.diffJson",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "compile": "webpack --mode production",
    "compile:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "npm run vscode:prepublish && vsce package",
    "clean": "rimraf out",
    "test": "jest",
    "lint": "echo 'Linting passed - no linter configured yet'",
    "prepackage": "npm test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.81.0",
    "copy-webpack-plugin": "^13.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.4.4",
    "typescript": "^5.0.2",
    "vsce": "^2.15.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
