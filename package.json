{
  "name": "jsonbro",
  "displayName": "JSONBro",
  "description": "Format, visualise and compare JSON. Repairs broken input, draws it as a tree or a graph, and diffs by structure rather than by line.",
  "version": "2.1.1",
  "license": "MIT",
  "publisher": "LucianDCrainic",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucianCrainic/JSONBro.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.81.0"
  },
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "json",
    "json diff",
    "json formatter",
    "json viewer",
    "jsonl"
  ],
  "galleryBanner": {
    "color": "#0A192F",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsonbro.formatJson",
        "title": "JSONBro: Format JSON"
      },
      {
        "command": "jsonbro.diffJson",
        "title": "JSONBro: Diff JSON"
      },
      {
        "command": "jsonbro.visualiseJson",
        "title": "JSONBro: Visualise JSON"
      },
      {
        "command": "jsonbro.openFile",
        "title": "JSONBro: Open JSON File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jsonbro.openFromActivityBar",
        "title": "Open JSONBro",
        "icon": "$(json)"
      },
      {
        "command": "jsonbro.removeFormatHistory",
        "title": "Remove Entry",
        "icon": "$(trash)"
      },
      {
        "command": "jsonbro.removeDiffHistory",
        "title": "Remove Entry",
        "icon": "$(trash)"
      },
      {
        "command": "jsonbro.renameFormatHistory",
        "title": "Rename Entry",
        "icon": "$(edit)"
      },
      {
        "command": "jsonbro.renameDiffHistory",
        "title": "Rename Entry",
        "icon": "$(edit)"
      },
      {
        "command": "jsonbro.loadFormatHistory",
        "title": "JSONBro: Load Format History Entry"
      },
      {
        "command": "jsonbro.loadDiffHistory",
        "title": "JSONBro: Load Diff History Entry"
      },
      {
        "command": "jsonbro.clearHistory",
        "title": "Clear History",
        "icon": "$(clear-all)"
      },
      {
        "command": "jsonbro.clearFormatHistory",
        "title": "Clear Format History",
        "icon": "$(clear-all)"
      },
      {
        "command": "jsonbro.clearDiffHistory",
        "title": "Clear Diff History",
        "icon": "$(clear-all)"
      },
      {
        "command": "jsonbro.setDiffOriginal",
        "title": "JSONBro: Use as Diff Original"
      },
      {
        "command": "jsonbro.setDiffModified",
        "title": "JSONBro: Use as Diff Modified"
      },
      {
        "command": "jsonbro.compareSelectedFiles",
        "title": "JSONBro: Compare Selected Files"
      },
      {
        "command": "jsonbro.clearRecentFiles",
        "title": "Clear Recent Files",
        "icon": "$(clear-all)"
      },
      {
        "command": "jsonbro.formatClipboard",
        "title": "JSONBro: Format from Clipboard"
      },
      {
        "command": "jsonbro.pinHistoryEntry",
        "title": "Pin",
        "icon": "$(pin)"
      },
      {
        "command": "jsonbro.unpinHistoryEntry",
        "title": "Unpin",
        "icon": "$(pinned)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jsonbro",
          "title": "JSONBro",
          "icon": "$(json)"
        }
      ]
    },
    "views": {
      "jsonbro": [
        {
          "id": "jsonbro.actions",
          "name": "Quick Actions"
        },
        {
          "id": "jsonbro.recentFiles",
          "name": "Recent Files"
        },
        {
          "id": "jsonbro.formatHistory",
          "name": "Format History"
        },
        {
          "id": "jsonbro.diffHistory",
          "name": "Diff History"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jsonbro.openFromActivityBar",
          "when": "view == jsonbro.actions",
          "group": "navigation@1"
        },
        {
          "command": "jsonbro.clearRecentFiles",
          "when": "view == jsonbro.recentFiles",
          "group": "navigation@1"
        },
        {
          "command": "jsonbro.clearFormatHistory",
          "when": "view == jsonbro.formatHistory",
          "group": "navigation@1"
        },
        {
          "command": "jsonbro.clearDiffHistory",
          "when": "view == jsonbro.diffHistory",
          "group": "navigation@1"
        },
        {
          "command": "jsonbro.clearHistory",
          "when": "view == jsonbro.formatHistory",
          "group": "overflow@1"
        }
      ],
      "view/item/context": [
        {
          "command": "jsonbro.pinHistoryEntry",
          "when": "view == jsonbro.formatHistory && viewItem == formatHistoryEntry",
          "group": "inline@1"
        },
        {
          "command": "jsonbro.unpinHistoryEntry",
          "when": "view == jsonbro.formatHistory && viewItem == formatHistoryEntryPinned",
          "group": "inline@1"
        },
        {
          "command": "jsonbro.renameFormatHistory",
          "when": "view == jsonbro.formatHistory && viewItem =~ /formatHistoryEntry/",
          "group": "inline@2"
        },
        {
          "command": "jsonbro.removeFormatHistory",
          "when": "view == jsonbro.formatHistory && viewItem =~ /formatHistoryEntry/",
          "group": "inline@3"
        },
        {
          "command": "jsonbro.pinHistoryEntry",
          "when": "view == jsonbro.diffHistory && viewItem == diffHistoryEntry",
          "group": "inline@1"
        },
        {
          "command": "jsonbro.unpinHistoryEntry",
          "when": "view == jsonbro.diffHistory && viewItem == diffHistoryEntryPinned",
          "group": "inline@1"
        },
        {
          "command": "jsonbro.renameDiffHistory",
          "when": "view == jsonbro.diffHistory && viewItem =~ /diffHistoryEntry/",
          "group": "inline@2"
        },
        {
          "command": "jsonbro.removeDiffHistory",
          "when": "view == jsonbro.diffHistory && viewItem =~ /diffHistoryEntry/",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "jsonbro.clearDiffHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.clearFormatHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.clearHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.clearRecentFiles",
          "when": "false"
        },
        {
          "command": "jsonbro.compareSelectedFiles",
          "when": "false"
        },
        {
          "command": "jsonbro.loadDiffHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.loadFormatHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.openFromActivityBar",
          "when": "false"
        },
        {
          "command": "jsonbro.pinHistoryEntry",
          "when": "false"
        },
        {
          "command": "jsonbro.removeDiffHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.removeFormatHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.renameDiffHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.renameFormatHistory",
          "when": "false"
        },
        {
          "command": "jsonbro.unpinHistoryEntry",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "jsonbro.openFile",
          "when": "resourceExtname =~ /\\.(json|jsonl|ndjson|txt)$/i",
          "group": "jsonbro@1"
        },
        {
          "command": "jsonbro.setDiffOriginal",
          "when": "resourceExtname =~ /\\.(json|jsonl|ndjson|txt)$/i",
          "group": "jsonbro@2"
        },
        {
          "command": "jsonbro.setDiffModified",
          "when": "resourceExtname =~ /\\.(json|jsonl|ndjson|txt)$/i",
          "group": "jsonbro@3"
        },
        {
          "command": "jsonbro.compareSelectedFiles",
          "when": "listMultiSelection && resourceExtname =~ /\\.(json|jsonl|ndjson|txt)$/i",
          "group": "jsonbro@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "jsonbro.openFile",
          "when": "resourceExtname =~ /\\.(json|jsonl|ndjson|txt)$/i",
          "group": "jsonbro@1"
        },
        {
          "command": "jsonbro.setDiffOriginal",
          "when": "resourceExtname =~ /\\.(json|jsonl|ndjson|txt)$/i",
          "group": "jsonbro@2"
        },
        {
          "command": "jsonbro.setDiffModified",
          "when": "resourceExtname =~ /\\.(json|jsonl|ndjson|txt)$/i",
          "group": "jsonbro@3"
        }
      ]
    },
    "configuration": {
      "title": "JSONBro",
      "properties": {
        "jsonbro.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line numbers beside formatted JSON."
        },
        "jsonbro.matchEditorTheme": {
          "type": "boolean",
          "default": true,
          "description": "Colour JSON the way the active colour theme colours it in the editor. When off, the colours contributed under 'jsonbro.syntax*' are used instead."
        },
        "jsonbro.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per level of indentation in formatted output."
        },
        "jsonbro.strictDiff": {
          "type": "boolean",
          "default": false,
          "description": "Start the diff view in strict mode, where keys present only on the right are ignored."
        },
        "jsonbro.defaultPaneRatio": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.2,
          "maximum": 0.8,
          "description": "Share of the width given to the input pane when the panel opens."
        },
        "jsonbro.autoFormatOnPaste": {
          "type": "boolean",
          "default": false,
          "description": "Format automatically when JSON is pasted into the input."
        },
        "jsonbro.search.defaultScope": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "keys",
            "values"
          ],
          "enumDescriptions": [
            "Search property names and values.",
            "Search property names only.",
            "Search values only."
          ],
          "description": "Which part of the document find starts by searching."
        },
        "jsonbro.maxInlineSize": {
          "type": "number",
          "default": 2097152,
          "description": "Characters of pasted input treated as editable. Larger documents are still formatted, but the panel stops trying to keep the input box responsive."
        },
        "jsonbro.diff.maxDocumentSize": {
          "type": "number",
          "default": 26214400,
          "description": "Largest document, in characters, that the diff view will compare. Comparing needs both sides in memory as values, so past this it reports the limit instead of attempting it."
        },
        "jsonbro.diff.arrayAlignBudget": {
          "type": "number",
          "default": 1000000,
          "description": "Ceiling on the array alignment pass, as old length times new length. Above it arrays are compared by position, which is faster but reports an insertion as a change to every later element."
        },
        "jsonbro.history.maxEntries": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "How many format and how many diff entries history keeps."
        },
        "jsonbro.history.maxEntrySize": {
          "type": "number",
          "default": 131072,
          "description": "Largest document stored whole, in bytes. Anything larger keeps a preview and says so."
        },
        "jsonbro.history.maxTotalSize": {
          "type": "number",
          "default": 5242880,
          "description": "Ceiling on everything history holds, in bytes, across format and diff entries together. Oldest entries are dropped first."
        }
      }
    },
    "colors": [
      {
        "id": "jsonbro.syntaxKey",
        "description": "Property names in formatted JSON. Used when the active theme cannot be read, or when jsonbro.matchEditorTheme is off.",
        "defaults": {
          "dark": "debugTokenExpression.name",
          "light": "debugTokenExpression.name",
          "highContrast": "debugTokenExpression.name",
          "highContrastLight": "debugTokenExpression.name"
        }
      },
      {
        "id": "jsonbro.syntaxString",
        "description": "String values in formatted JSON.",
        "defaults": {
          "dark": "debugTokenExpression.string",
          "light": "debugTokenExpression.string",
          "highContrast": "debugTokenExpression.string",
          "highContrastLight": "debugTokenExpression.string"
        }
      },
      {
        "id": "jsonbro.syntaxNumber",
        "description": "Numbers in formatted JSON.",
        "defaults": {
          "dark": "debugTokenExpression.number",
          "light": "debugTokenExpression.number",
          "highContrast": "debugTokenExpression.number",
          "highContrastLight": "debugTokenExpression.number"
        }
      },
      {
        "id": "jsonbro.syntaxBoolean",
        "description": "true and false in formatted JSON.",
        "defaults": {
          "dark": "debugTokenExpression.boolean",
          "light": "debugTokenExpression.boolean",
          "highContrast": "debugTokenExpression.boolean",
          "highContrastLight": "debugTokenExpression.boolean"
        }
      },
      {
        "id": "jsonbro.syntaxNull",
        "description": "null in formatted JSON.",
        "defaults": {
          "dark": "debugTokenExpression.boolean",
          "light": "debugTokenExpression.boolean",
          "highContrast": "debugTokenExpression.boolean",
          "highContrastLight": "debugTokenExpression.boolean"
        }
      },
      {
        "id": "jsonbro.syntaxPunctuation",
        "description": "Braces, brackets, commas and colons in formatted JSON.",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "jsonbro.addedBackground",
        "description": "Fill behind an added value, for themes that leave diffEditor.insertedTextBackground unset.",
        "defaults": {
          "dark": "#2ea04326",
          "light": "#2ea04326",
          "highContrast": "#2ea04340",
          "highContrastLight": "#2ea04340"
        }
      },
      {
        "id": "jsonbro.removedBackground",
        "description": "Fill behind a removed value, for themes that leave diffEditor.removedTextBackground unset.",
        "defaults": {
          "dark": "#f8514926",
          "light": "#f8514926",
          "highContrast": "#f8514940",
          "highContrastLight": "#f8514940"
        }
      },
      {
        "id": "jsonbro.modifiedBackground",
        "description": "Fill behind a modified change row.",
        "defaults": {
          "dark": "#e2c08d1a",
          "light": "#8955031a",
          "highContrast": "#e2c08d33",
          "highContrastLight": "#89550333"
        }
      }
    ],
    "keybindings": [
      {
        "command": "jsonbro.formatJson",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      },
      {
        "command": "jsonbro.diffJson",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "jsonbro.openFile",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "jsonbro.visualiseJson",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "viewsWelcome": [
      {
        "view": "jsonbro.recentFiles",
        "contents": "No files opened yet.\n[Open a JSON file](command:jsonbro.openFile)"
      },
      {
        "view": "jsonbro.formatHistory",
        "contents": "Nothing formatted yet. Documents you format are saved here.\n[Format JSON](command:jsonbro.formatJson)"
      },
      {
        "view": "jsonbro.diffHistory",
        "contents": "Nothing compared yet. Comparisons you run are saved here.\n[Compare JSON](command:jsonbro.diffJson)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "compile": "webpack --mode production",
    "compile:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "npm run vscode:prepublish && vsce package",
    "clean": "rimraf out",
    "test": "jest",
    "lint": "echo 'Linting passed - no linter configured yet'",
    "prepackage": "npm test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.81.0",
    "copy-webpack-plugin": "^13.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.4.4",
    "typescript": "^5.0.2",
    "vsce": "^2.15.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
